<!-- views/admin/carrers.ejs -->

<% layout("layouts/admin2") %>

<main class="main-content"> <div class="container-fluid">
<!-- PAGE HEADER -->
<h3 class="mb-4">
  <a href="/admin/academic">
    <i class="fa fa-book me-2"></i>
    Gestión Académica
  </a>
  / Alumnos
</h3>

<div class="alert d-none" role="alert" id="alertMessage">
    A simple danger alert—check it out!
</div>

<div class="row">

  <!-- ========================= -->
  <!-- FORMULARIO -->
  <!-- ========================= -->
  <div class="col-lg-4 col-md-5 mb-4">

    

    <div class="card">

      <div class="card-header">
        <h6 class="mb-0" id="cardTitle">
          <i class="fa fa-plus me-2"></i>
          Nuevo Alumno
        </h6>
      </div>

      <div class="card-body">

        <form method="POST" action="/carrers">

          <div class="mb-3">

            <label for="name" class="form-label">
              Nombre
            </label>

            <input type="hidden" name="" id="alumnoId">

            <input
              type="text"
              id="name"
              name="name"
              class="form-control"
              placeholder="Ingrese el nombre..."
              required
            >
          </div>

          <div class="mb-3">

            <label for="name" class="form-label">
              Apellido
            </label>

            <input type="hidden" name="" id="apellidoId">

            <input
              type="text"
              id="name"
              name="name"
              class="form-control"
              placeholder="Ingrese el apellido..."
              required
            >
          </div>

          <div class="mb-3">

            <label for="name" class="form-label">
              Carrera
            </label>

            <input type="hidden" name="" id="carreraId">

            <input
              type="text"
              id="name"
              name="name"
              class="form-control"
              placeholder="Ingrese la carrera..."
              required
            >
          </div>

          <div class="mb-3">

            <label for="name" class="form-label">
              Edad
            </label>

            <input
              type="text"
              id="name"
              name="name"
              class="form-control"
              placeholder="Ingrese la edad..."
              required
            >

          </div>


          <div class="d-flex justify-content-end gap-2">

            <button
              class="btn btn-outline-secondary"
              onclick="limpiar(event)"
            >
              <i class="fa fa-refresh me-1"></i>
              Limpiar
          </button>

            <button
              type="submit"
              class="btn btn-success"
              id="btnGuardar"
              onclick="agregar(event)"
            >
              <i class="fa fa-save me-1"></i>
              Guardar
            </button>

          </div>

        </form>

      </div>

    </div>

  </div>


  <!-- ========================= -->
  <!-- LISTADO -->
  <!-- ========================= -->
  <div class="col-lg-8 col-md-7 mb-4">

    <div class="card">

      <div class="card-header">
        <h6 class="mb-0">
          <i class="fa fa-list me-2"></i>
          Lista de Alumnos
        </h6>
      </div>


      <div class="card-body">

        <!-- HEADER ACTIONS -->
        <div class="d-flex justify-content-between align-items-center mb-3">

          <div class="text-muted">
            <i class="fa fa-graduation-cap me-1"></i>
            Alumnos registrados
          </div>

          <div>
            <a
              href="/carrers/new"
              class="btn btn-success"
            >
              <i class="fa fa-plus"></i>
              Agregar Registro
            </a>
          </div>

        </div>


        <!-- TABLE -->
        <div class="table-responsive">

          <table class="table table-striped table-hover" id="carrers">

            <thead>
              <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Carrera</th>
                <th>Edad</th>
                <th class="text-end">Acciones</th>
              </tr>
            </thead>


            <tbody>

              <% if (carrers && carrers.length > 0) { %>

                <% for (const carrer of carrers) { %>

                  <tr>

                    <td>
                      <%= carrer.id %>
                    </td>

                    <td>
                      <%= carrer.nombre %>
                    </td>

                    <td>
                      <%= carrer.apellido %>
                    </td>

                    <td>
                      <%= carrer.carrera %>
                    </td>

                    <td>
                      <%= carrer.edad %>
                    </td>

                    <td class="text-end">

                      <button
                        class="btn btn-sm btn-outline-secondary me-1"
                        onclick="editar(<%= carrer.id %>, event)"
                      >
                        <i class="fa fa-edit" ></i>
                        Editar
                    </button>

                      <button
                        class="btn btn-sm btn-outline-danger"
                        onclick="eliminar(<%= carrer.id %>, event)"
                      >
                        <i class="fa fa-trash"></i>
                        Eliminar
                    </button>

                    </td>

                  </tr>

                <% } %>

              <% } else { %>

                <tr>
                  <td colspan="3" class="text-center text-muted py-4">
                    No se encontraron carreras.
                  </td>
                </tr>

              <% } %>

            </tbody>

          </table>

        </div>

      </div>

    </div>

  </div>

</div>

</div> </main>

<script>
    let carrerRows = document.getElementById("carrers").children[1].children.length;

    function limpiar(event){
      event.preventDefault();
      document.getElementById("alumnoId").value="";
      document.getElementById("nombreId").value="";
      document.getElementById("cardTitle").innerHTML = "Nueva Alumno";
    }

    function agregar(event){
        event.preventDefault();

        let name = document.getElementById("alumnoId").value;
        let apellido = document.getElementById("apellidoId").value;
        let carrera = document.getElementById("carreraId").value;
        let edad = document.getElementById("edadId").value;
        let carrersTable = document.getElementById("carrers");
        let carrerId = document.getElementById("carrerId").value;
        let alertMessage = document.getElementById("alertMessage");

        if(name == "" || apellido == "" || carrera == "" || edad ==""){
          alertMessage.classList.remove("d-none");
          alertMessage.classList.add("alert-danger");
          alertMessage.classList.remove("alert-success");
          alertMessage.innerHTML = "Debe completar todos los campos";

        }else{
          alertMessage.classList.remove("d-none");
          alertMessage.classList.remove("alert-danger");
          alertMessage.classList.add("alert-success");
          alertMessage.innerHTML = "Alumno registrado correctamente";
      }
    }

        setInterval(() => {
          alertMessage.classList.add("d-none");
          }, 5000);

        if(carrerId==""){
          let tr = document.createElement("TR");
          let td1 = document.createElement("TD");
          let td2 = document.createElement("TD");
          let td3 = document.createElement("TD");
          let td4 = document.createElement("TD");
          let td5 = document.createElement("TD");
          

          carrerRows = carrerRows + 1;
          td1.innerHTML = carrerRows;
          td2.innerHTML = name;
          td3.innerHTML = apellido;
          td4.innerHTML = carrera;
          td5.innerHTML = edad;
          

          tr.appendChild(td1);
          tr.appendChild(td2);
          tr.appendChild(td3);
          tr.appendChild(td4);
          tr.appendChild(td5);
          

          console.log(tr);

          carrersTable.children[1].appendChild(tr);
        }else{
          let tbody = carrersTable.children[1];

          for (let tr of tbody.children) {
            console.log("1 ++++++++++++++++++++")
            console.log(typeof tr.children[0].innerHTML.trim())
            console.log(typeof carrerId)
            if(tr.children[0].innerHTML.trim() == carrerId){
              tr.children[1].innerHTML = name;
              document.getElementById("carrerId").value="";
              document.getElementById("alumnoId").value="";
              document.getElementById("apellidoId").value="";
              document.getElementById("carreraId").value="";
              document.getElementById("edadId").value="";
              document.getElementById("cardTitle").innerHTML = "Nuevo Alumno";
            }
          }
        }
    }

    function eliminar(id, event){
        let tr = event.currentTarget.parentElement.parentElement;
        tr.remove();
    }

    function editar(id, event){
        let tr = event.currentTarget.parentElement.parentElement;
        let idRow = tr.children[0].innerHTML;
        let name = tr.children[1].innerHTML;
        let apellido = tr.children[2].innerHTML;
        let carrera = tr.children[3].innerHTML;
        let edad = tr.children[4].innerHTML;

        document.getElementById("cardTitle").innerHTML = "Editar Alumno";

        document.getElementById("alumnoId").value = name.trim();
        document.getElementById("carrerId").value = id;
    }
</script>